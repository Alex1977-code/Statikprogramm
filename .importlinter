[importlinter]
root_packages =
    statik3d
    statik3d_contracts
    volumen3d
include_external_packages = True

[importlinter:contract:vertrag-nur-stdlib-und-numpy]
name = statik3d_contracts importiert nur Standardbibliothek und numpy
type = forbidden
source_modules =
    statik3d_contracts
forbidden_modules =
    statik3d
    volumen3d
    scipy
    PySide6

[importlinter:contract:hauptprogramm-kennt-volumen3d-nicht]
name = statik3d importiert volumen3d nie direkt (nur Entry Points, Vertrag Abschnitt 7)
type = forbidden
source_modules =
    statik3d
forbidden_modules =
    volumen3d

[importlinter:contract:volumen3d-kennt-kein-statik3d]
name = volumen3d importiert niemals statik3d oder Qt/VTK (Vertrag Abschnitt 1)
type = forbidden
source_modules =
    volumen3d
forbidden_modules =
    statik3d
    PySide6
    pyvista
    vtk
